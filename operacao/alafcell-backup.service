[Unit]
Description=Backup do banco da Alafcell
After=alafcell.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/var/www/projetos/Alafcell-Assistec
Environment=ALAFCELL_BACKUPS_MANTER=14
ExecStart=/usr/bin/node ferramentas/backup.cjs

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# O `-` na frente: pasta que não existe derrubaria a unidade com 226/NAMESPACE,
# e a mensagem não diz que o problema é uma pasta.
ReadWritePaths=-/var/www/projetos/Alafcell-Assistec/data
ReadWritePaths=-/var/www/projetos/Alafcell-Assistec/backups

SyslogIdentifier=alafcell-backup
